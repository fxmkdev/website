{
  "packageManager": "pnpm@11.2.2+sha512.36e6621fad506178936455e70247b8808ef4ec25797a9f437a93281a020484e2607f6a469a22e982987c3dbb8866e3071514ab10a4a1749e06edcd1ec118436f",
  "version": "0.0.0-unknown",
  "scripts": {
    "generate:types": "pnpm --filter @fxmk/payload-types pull-payload-types",
    "lint": "pnpm --filter @fxmk/frontend lint --max-warnings=0 && pnpm --filter @fxmk/cms lint --max-warnings=0",
    "check-format": "pnpm --filter @fxmk/frontend check-format && pnpm --filter @fxmk/cms check-format",
    "typecheck": "pnpm generate:types && pnpm typecheck:generated",
    "typecheck:generated": "pnpm --filter @fxmk/frontend typecheck",
    "test": "pnpm --filter @fxmk/frontend exec vitest run",
    "build": "pnpm generate:types && pnpm build:generated",
    "build:generated": "pnpm --filter @fxmk/frontend build && pnpm --filter @fxmk/cms build:generated",
    "check": "pnpm generate:types && pnpm check-format && pnpm lint && pnpm typecheck:generated && pnpm test && pnpm build:generated"
  },
  "devDependencies": {
    "@fxmk/releaser": "^0.5.5",
    "prettier": "^3.8.3"
  },
  "dependencies": {
    "payload": "^3.90.2"
  }
}

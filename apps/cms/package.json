{
  "name": "@fxmk/cms",
  "version": "0.0.0-unknown",
  "description": "Website template for Payload",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "build": "pnpm generate:types && pnpm build:generated",
    "build:generated": "cross-env NODE_OPTIONS=--no-deprecation next build",
    "dev": "cross-env NODE_OPTIONS=--no-deprecation PORT=3001 next dev",
    "dev:prod": "cross-env NODE_OPTIONS=--no-deprecation rm -rf .next && pnpm build && mv .next/static .next/standalone/apps/cms/.next/static && pnpm start",
    "generate:importmap": "cross-env NODE_OPTIONS=--no-deprecation payload generate:importmap",
    "generate:types": "cross-env NODE_OPTIONS=--no-deprecation payload generate:types",
    "lint": "cross-env NODE_OPTIONS=--no-deprecation eslint .",
    "lint:fix": "cross-env NODE_OPTIONS=--no-deprecation eslint . --fix",
    "payload": "cross-env NODE_OPTIONS=--no-deprecation payload",
    "reinstall": "cross-env NODE_OPTIONS=--no-deprecation rm -rf node_modules && rm pnpm-lock.yaml && pnpm --ignore-workspace install",
    "start": "cross-env NODE_OPTIONS=--no-deprecation PORT=3001 node .next/standalone/apps/cms/server.js",
    "check-format": "prettier --check ."
  },
  "dependencies": {
    "@fxmk/shared": "workspace:../../libs/shared",
    "@payloadcms/db-mongodb": "^3.94.1",
    "@payloadcms/next": "^3.94.1",
    "@payloadcms/plugin-form-builder": "^3.94.1",
    "@payloadcms/plugin-nested-docs": "^3.94.1",
    "@payloadcms/plugin-redirects": "^3.94.1",
    "@payloadcms/plugin-search": "^3.94.1",
    "@payloadcms/plugin-seo": "^3.94.1",
    "@payloadcms/richtext-lexical": "^3.94.1",
    "@payloadcms/storage-s3": "^3.94.1",
    "@payloadcms/ui": "^3.94.1",
    "cookie": "^1.1.1",
    "cross-env": "^7.0.3",
    "next": "^16.4.6",
    "openai": "^6.38.0",
    "payload": "^3.94.1",
    "react": "~19.2.9",
    "react-dom": "~19.2.9",
    "sharp": "^0.35.5"
  },
  "devDependencies": {
    "@eslint/compat": "^2.1.0",
    "@types/node": "^26.6.6",
    "@types/react": "^19.2.15",
    "@types/react-dom": "^19.2.3",
    "eslint": "^10.4.0",
    "eslint-config-next": "^16.4.6",
    "prettier": "^3.8.3",
    "typescript": "^6.0.3"
  },
  "engines": {
    "node": ">=26.13.1 <27"
  },
  "packageManager": "pnpm@12.21.0+sha512.66fd8278ee28935ce951792d34367ff3af5c432a2756445823029533835b8da529bbe0be5130afd56ed0713fb8789e47bad82d93bd5ae2fe54b15562d6276ef0"
}

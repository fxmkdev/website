{
  "name": "@fxmk/cms",
  "version": "0.0.0-unknown",
  "description": "Website template for Payload",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "build": "pnpm generate:types && pnpm build:generated",
    "build:generated": "cross-env NODE_OPTIONS=--no-deprecation next build",
    "dev": "cross-env NODE_OPTIONS=--no-deprecation PORT=3001 next dev",
    "dev:prod": "cross-env NODE_OPTIONS=--no-deprecation rm -rf .next && pnpm build && mv .next/static .next/standalone/apps/cms/.next/static && pnpm start",
    "generate:importmap": "cross-env NODE_OPTIONS=--no-deprecation payload generate:importmap",
    "generate:types": "cross-env NODE_OPTIONS=--no-deprecation payload generate:types",
    "lint": "cross-env NODE_OPTIONS=--no-deprecation eslint .",
    "lint:fix": "cross-env NODE_OPTIONS=--no-deprecation eslint . --fix",
    "payload": "cross-env NODE_OPTIONS=--no-deprecation payload",
    "reinstall": "cross-env NODE_OPTIONS=--no-deprecation rm -rf node_modules && rm pnpm-lock.yaml && pnpm --ignore-workspace install",
    "start": "cross-env NODE_OPTIONS=--no-deprecation PORT=3001 node .next/standalone/apps/cms/server.js",
    "check-format": "prettier --check ."
  },
  "dependencies": {
    "@fxmk/shared": "workspace:../../libs/shared",
    "@payloadcms/db-mongodb": "^3.90.2",
    "@payloadcms/next": "^3.90.2",
    "@payloadcms/plugin-form-builder": "^3.90.2",
    "@payloadcms/plugin-nested-docs": "^3.90.2",
    "@payloadcms/plugin-redirects": "^3.90.2",
    "@payloadcms/plugin-search": "^3.90.2",
    "@payloadcms/plugin-seo": "^3.90.2",
    "@payloadcms/richtext-lexical": "^3.90.2",
    "@payloadcms/storage-s3": "^3.90.2",
    "@payloadcms/ui": "^3.90.2",
    "cookie": "^1.1.1",
    "cross-env": "^7.0.3",
    "next": "^16.4.0",
    "openai": "^6.38.0",
    "payload": "^3.90.2",
    "react": "^19.2.6",
    "react-dom": "^19.2.6",
    "sharp": "^0.35.5"
  },
  "devDependencies": {
    "@eslint/compat": "^2.1.0",
    "@types/node": "^24.12.4",
    "@types/react": "^19.2.15",
    "@types/react-dom": "^19.2.3",
    "eslint": "^10.4.0",
    "eslint-config-next": "^16.2.6",
    "prettier": "^3.8.3",
    "typescript": "^6.0.3"
  },
  "engines": {
    "node": ">=24 <25"
  },
  "packageManager": "pnpm@11.2.2+sha512.36e6621fad506178936455e70247b8808ef4ec25797a9f437a93281a020484e2607f6a469a22e982987c3dbb8866e3071514ab10a4a1749e06edcd1ec118436f"
}

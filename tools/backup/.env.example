# Copy to .env.<environment>; these files are ignored. Never commit credentials.
DATABASE_URI=mongodb://127.0.0.1:27017/website-cms
S3_BUCKET=your-media-bucket
AWS_PROFILE=website
AWS_REGION=eu-central-1
# Optional endpoint override, for example the disposable Moto server:
# S3_ENDPOINT_URL=http://localhost:5000
